[Unit]
Description=pavfan fan-control daemon (HP Pavilion Gaming 15-dk1xxx)
Documentation=https://github.com/Kyr4l/pavfan
# ec_sys must be loaded with write_support=1 (packaging/modules-load.d + modprobe.d).
After=systemd-modules-load.service dbus.service
Wants=systemd-modules-load.service
ConditionPathExists=/sys/class/dmi/id/board_name

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/pavfand --no-module-setup
# If the daemon is SIGKILLed it cannot clean up; make sure the BIOS gets the fans back.
ExecStopPost=-/usr/bin/pavfan release --no-module-setup
Restart=on-failure
RestartSec=5s
# 3 = not the supported machine, 4 = no EC access: retrying cannot help.
RestartPreventExitStatus=3 4
# The daemon pings every control tick (1 s); a stalled loop gets killed and restarted,
# and ExecStopPost hands the fans back in between.
WatchdogSec=15s
TimeoutStopSec=10s
StateDirectory=pavfan
ConfigurationDirectory=pavfan
UMask=0077

# --- sandbox -------------------------------------------------------------
# Needs: root (debugfs is root-only), /sys/kernel/debug writable, the D-Bus
# system bus, and nvidia-smi for the GPU temperature. Nothing else.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Deliberately NOT set: ProtectKernelTunables (would make /sys/kernel/debug read-only),
# PrivateDevices/DevicePolicy (nvidia-smi needs /dev/nvidia*).

[Install]
WantedBy=multi-user.target
